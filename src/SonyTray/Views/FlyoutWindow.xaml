<Window x:Class="SonyTray.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sony Tray" Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent">
    <Border Background="#F2242424" CornerRadius="8" Padding="16" Margin="8"
            BorderBrush="#3FFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="WH-1000XM5" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding BatteryText}" Foreground="#B0FFFFFF" FontSize="14"
                           DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>

            <UniformGrid Columns="3" IsEnabled="{Binding IsConnected}">
                <UniformGrid.Resources>
                    <Style TargetType="RadioButton">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Chip" Background="#33FFFFFF" CornerRadius="6" Padding="8,10">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="#FF0078D4"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </UniformGrid.Resources>
                <RadioButton Content="Noise Cancel" GroupName="Mode" IsChecked="{Binding IsNcSelected}"/>
                <RadioButton Content="Ambient" GroupName="Mode" IsChecked="{Binding IsAmbientSelected}"/>
                <RadioButton Content="Off" GroupName="Mode" IsChecked="{Binding IsOffSelected}"/>
            </UniformGrid>

            <StackPanel Margin="2,12,2,0" IsEnabled="{Binding AmbientControlsEnabled}">
                <DockPanel>
                    <TextBlock Text="Ambient level" Foreground="#B0FFFFFF"/>
                    <TextBlock Text="{Binding AmbientLevel}" Foreground="White" DockPanel.Dock="Right"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding AmbientLevel, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="Focus on voice" Foreground="#B0FFFFFF" Margin="0,6,0,0"
                          IsChecked="{Binding FocusOnVoice}"/>
            </StackPanel>

            <StackPanel Margin="2,14,2,0" IsEnabled="{Binding IsConnected}">
                <DockPanel>
                    <TextBlock Text="Equalizer" Foreground="#B0FFFFFF" VerticalAlignment="Center"/>
                    <ComboBox DockPanel.Dock="Right" Width="140" HorizontalAlignment="Right"
                              ItemsSource="{Binding EqPresets}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedEqPreset}"/>
                </DockPanel>
                <Grid Margin="0,10,0,0" IsEnabled="{Binding EqBandsEditable}" Height="110">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style TargetType="Slider">
                            <Setter Property="Orientation" Value="Vertical"/>
                            <Setter Property="Minimum" Value="-10"/>
                            <Setter Property="Maximum" Value="10"/>
                            <Setter Property="TickFrequency" Value="1"/>
                            <Setter Property="IsSnapToTickEnabled" Value="True"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Height" Value="86"/>
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#80FFFFFF"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                        </Style>
                    </Grid.Resources>
                    <StackPanel Grid.Column="0"><Slider Value="{Binding ClearBass, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="CB"/></StackPanel>
                    <StackPanel Grid.Column="1"><Slider Value="{Binding Band1, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="400"/></StackPanel>
                    <StackPanel Grid.Column="2"><Slider Value="{Binding Band2, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="1k"/></StackPanel>
                    <StackPanel Grid.Column="3"><Slider Value="{Binding Band3, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="2.5k"/></StackPanel>
                    <StackPanel Grid.Column="4"><Slider Value="{Binding Band4, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="6.3k"/></StackPanel>
                    <StackPanel Grid.Column="5"><Slider Value="{Binding Band5, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="16k"/></StackPanel>
                </Grid>
            </StackPanel>

            <TextBlock Text="{Binding StatusText}" Foreground="#80FFFFFF" FontSize="11" Margin="2,14,2,0"/>
        </StackPanel>
    </Border>
</Window>
